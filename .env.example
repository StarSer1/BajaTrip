# Copia este archivo como .env (Git lo ignora) y cambia las dos contraseñas.
DB_PASSWORD=cambia-esta-contrasena
DB_ROOT_PASSWORD=cambia-tambien-esta

# Captcha del registro (Cloudflare Turnstile). Estas son las llaves de PRUEBA que publica
# Cloudflare: el widget siempre pasa y sirven para probar sin cuenta. Para el sitio real, crea un
# widget en el panel de Cloudflare (Turnstile) y pega aquí su sitekey y su secret.
TURNSTILE_SITEKEY=1x00000000000000000000AA
TURNSTILE_SECRET=1x0000000000000000000000000000000AA

# Dirección pública del sitio. En local, el balanceador sirve HTTPS en el puerto 8443.
DOMINIO=localhost
HTTPS_PUERTO=8443
# HSTS: en local se deja corto (5 min) para no atrapar a localhost en HTTPS si algo sale mal.
# Con dominio y certificado de Let's Encrypt ya probados: 31536000 (un año).
HSTS_MAX_AGE=300
