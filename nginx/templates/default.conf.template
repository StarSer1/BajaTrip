# Balanceador de BajaTrip (Prácticas 5 y 6).
# Es una plantilla: al arrancar, la imagen oficial de Nginx reemplaza ${DOMINIO}, ${HTTPS_PUERTO},
# ${HSTS_MAX_AGE}, ${CERTIFICADO} y ${LLAVE} con las variables de docker-compose.yml y guarda el
# resultado como /etc/nginx/conf.d/default.conf. Las variables de Nginx ($host, $remote_addr…) no
# se tocan porque no existen como variables de entorno.
# En tres computadoras: cambia cada IP del upstream por la del nodo y el puerto 3000 por el que use.

# No anunciar la versión de Nginx en las páginas de error ni en la cabecera Server.
server_tokens off;

# Segunda capa del límite de intentos (la primera está en la base de datos, backend/modules/auth/limite.js).
# Una zona de 10 MB guarda unas 160 000 IP; cada IP puede hacer 120 peticiones por minuto a /api/auth/.
limit_req_zone $binary_remote_addr zone=cuentas:10m rate=120r/m;
# Responder 429 (demasiadas peticiones) en lugar del 503 que Nginx usa por defecto.
limit_req_status 429;

upstream bajatrip {
    # Memoria compartida: los procesos de Nginx llevan juntos el turno, las conexiones abiertas
    # y los nodos caídos. Sin esto cada proceso tiene su propia cuenta y el reparto no alterna.
    zone bajatrip 64k;
    # Algoritmo: turno rotatorio por defecto. Para el segundo, quita el # de least_conn y
    # reinicia: docker compose restart balanceador (la plantilla se vuelve a procesar)
    # least_conn;
    # max_fails=2 fail_timeout=10s: dos fallos seguidos sacan al nodo de la rotación 10 segundos.
    server 172.28.0.11:3000 max_fails=2 fail_timeout=10s;
    server 172.28.0.12:3000 max_fails=2 fail_timeout=10s;
}

# --- Puerto 80 (HTTP): solo redirige a HTTPS -------------------------------------------------
server {
    listen 80;
    server_name ${DOMINIO};

    # Let's Encrypt comprueba que el dominio es nuestro pidiendo un archivo en esta ruta por HTTP.
    # Certbot lo deja en /var/www/certbot (perfil «publico» de docker-compose.yml).
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Todo lo demás: 301 (permanente) a la misma dirección con https://. Nada se sirve sin cifrar.
    location / {
        return 301 https://$host:${HTTPS_PUERTO}$request_uri;
    }
}

# --- Puerto 443 (HTTPS): aquí termina TLS ----------------------------------------------------
# El certificado vive SOLO en el balanceador. De aquí a los nodos el tráfico va por la red
# privada de Docker (bajatrip-red, 172.28.0.0/24), a la que nadie de afuera llega.
server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMINIO};

    # Certificado (con la cadena intermedia) y su llave privada. La llave nunca va al repositorio:
    # nginx/certs/ y nginx/letsencrypt/ están en .gitignore.
    ssl_certificate     ${CERTIFICADO};
    ssl_certificate_key ${LLAVE};
    # Solo TLS 1.2 y 1.3: SSLv3, TLS 1.0 y 1.1 tienen fallas conocidas.
    ssl_protocols TLSv1.2 TLSv1.3;
    # Reutilizar el saludo TLS de un mismo visitante durante 10 minutos (más rápido, igual de seguro).
    ssl_session_cache shared:TLS:10m;
    ssl_session_timeout 10m;
    # Sin tickets de sesión: con la misma llave de tickets durante días se pierde el secreto hacia adelante.
    ssl_session_tickets off;

    # --- Las cinco cabeceras de seguridad. «always» las agrega también en respuestas de error. ---
    # 1. CSP: de dónde puede cargar cosas la página. Un <script> escrito dentro del HTML (o
    #    inyectado) no viene de 'self' ni de una lista permitida, así que el navegador no lo ejecuta.
    #    challenges.cloudflare.com es el captcha (Turnstile); fonts.* las fuentes; Unsplash las fotos.
    #    report-uri: el navegador avisa al backend de cada bloqueo (queda en la bitácora).
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://images.unsplash.com; connect-src 'self' https://fonts.googleapis.com https://fonts.gstatic.com https://images.unsplash.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; report-uri /api/csp-reporte" always;
    # 2. HSTS: el navegador recordará usar HTTPS con este sitio durante max-age segundos, aunque
    #    escriban http://. En local se deja en 300 s (ver .env.example); con dominio, un año.
    add_header Strict-Transport-Security "max-age=${HSTS_MAX_AGE}" always;
    # 3. No adivinar el tipo de un archivo: usar el Content-Type que mandamos.
    add_header X-Content-Type-Options "nosniff" always;
    # 4. A otros sitios solo se les dice el dominio de donde viene el visitante, no la ruta completa.
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    # 5. La página no usa cámara, micrófono, ubicación, pagos ni USB: se apagan.
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
    # Extra para navegadores viejos que no entienden frame-ancestors: no mostrar el sitio en un iframe.
    add_header X-Frame-Options "DENY" always;
    # Para comprobar el reparto (Práctica 5): en F12 › Red se ve qué nodo atendió.
    add_header X-Nodo $upstream_addr always;

    # Los nodos mandan sus propias cabeceras básicas (por si alguien llega directo a ellos). Aquí
    # se quitan para que no salgan repetidas junto con las del balanceador.
    proxy_hide_header X-Content-Type-Options;
    proxy_hide_header Referrer-Policy;
    proxy_hide_header X-Frame-Options;

    # Lo que el nodo necesita saber de la petición original. El backend solo cree estas cabeceras
    # si vienen de la IP del balanceador (PROXIES_CONFIABLES en docker-compose.yml).
    proxy_set_header Host              $http_host;                  # con el puerto
    proxy_set_header X-Real-IP         $remote_addr;                # IP real del visitante
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;                     # «https»: el nodo marca la cookie como Secure

    # Un nodo apagado no contesta: a los 2 s se intenta con el otro en lugar de esperar 60.
    proxy_connect_timeout 2s;
    proxy_next_upstream error timeout http_502 http_503 http_504;

    # Cuerpos de hasta 16 KB en general (el backend tiene su propio límite por ruta).
    client_max_body_size 16k;

    # El navegador pide el icono en cada recarga y se come un turno.
    location = /favicon.ico { return 204; }

    # Inicio de sesión y registro: además del límite por cuenta del backend, un tope general por IP
    # contra inundaciones (120 por minuto). burst=60 deja pasar ráfagas cortas sin hacerlas esperar.
    location /api/auth/ {
        limit_req zone=cuentas burst=60 nodelay;
        proxy_pass http://bajatrip;
    }

    # La foto de perfil es la única ruta que recibe archivos: hasta 2 MB, igual que en el backend.
    location = /api/cuenta/foto {
        client_max_body_size 2m;
        proxy_pass http://bajatrip;
    }

    location / {
        proxy_pass http://bajatrip;
    }
}
